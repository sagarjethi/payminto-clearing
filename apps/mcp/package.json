{
  "name": "@payminto/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that gives any MCP-capable agent a mandate-bound, budgeted wallet on Payminto Clearing",
  "bin": {
    "payminto-mcp": "./src/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:http": "node src/main.ts --http",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@payminto/protocol": "workspace:*",
    "@payminto/sdk": "workspace:*",
    "viem": "^2.57.10",
    "zod": "^4.6.7",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@payminto/node": "workspace:*"
  }
}
