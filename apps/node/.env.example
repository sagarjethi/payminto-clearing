# Payminto Clearing Node configuration. Copy to .env (git-ignored) and fill in.
# Every value is validated at startup; errors name the variable, never its value.

# HTTP
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed by CORS (the dashboard). Use * only for local experiments.
CORS_ORIGINS=http://localhost:3000

# Chain: 31337 (local anvil), 133 (HashKey testnet) or 177 (HashKey mainnet)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Optional: default to contracts/deployments/<CHAIN_ID>.json, then the network default token.
# HUB_ADDRESS=
# TOKEN_ADDRESS=

# Node operator key: signs receipts and submits openMandate/settleBatch (pays gas only, never holds funds).
# This is the public anvil dev key 9. Never use an anvil key on a real network.
OPERATOR_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# Bearer token for admin routes and the dashboard (at least 12 characters). Generate a long random one outside dev.
ADMIN_TOKEN=dev-admin-token

# Storage (SQLite, WAL). Tests never use this path.
DB_PATH=./data/clearing.db

# Settlement: 0 = manual only (POST /v1/settlements).
SETTLE_INTERVAL_SEC=0
SETTLE_MIN_CALLS=1
FUNDS_REFRESH_SEC=30

# HSP: local (built-in adapter + verifier) or coordinator (HashKey HSP Coordinator).
HSP_MODE=local
HSP_COSIGN_TIMEOUT_SEC=20
# Required when HSP_MODE=coordinator; HSP_VERIFYING_CONTRACT defaults to the hub in local mode.
# HSP_COORDINATOR_URL=
# HSP_API_KEY=
# HSP_CHAIN_NAME=
# HSP_VERIFYING_CONTRACT=

LOG_LEVEL=info
