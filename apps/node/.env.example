# Payminto Clearing Node configuration. Copy to .env (git-ignored) and fill in.
# Every value is validated at startup; errors name the variable, never its value.

# HTTP
PORT=8787
# Loopback by default; put a TLS reverse proxy in front (docs/OPERATIONS.md). The Docker image binds 0.0.0.0.
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed by CORS (the dashboard). Use * only for local experiments.
CORS_ORIGINS=http://localhost:3000

# Chain: 31337 (local anvil), 133 (HashKey testnet) or 177 (HashKey mainnet)
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
# Extra endpoints tried in order when RPC_URL fails. Unset: the network's public fallbacks on 133/177. "none" disables.
# RPC_FALLBACK_URLS=https://hashkey.drpc.org,https://177.rpc.thirdweb.com
# First block of the revocation scan. Defaults to blockNumber in contracts/deployments/<CHAIN_ID>.json; required on 133/177 without it.
# DEPLOY_BLOCK=
# Optional: default to contracts/deployments/<CHAIN_ID>.json, then the network default token.
# HUB_ADDRESS=
# TOKEN_ADDRESS=

# Node operator key: signs receipts and submits openMandate/settleBatch (pays gas only, never holds funds).
# This is the public anvil dev key 9. On 133/177 the node refuses all ten public anvil/hardhat keys.
OPERATOR_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
# Bearer token for admin routes, /metrics and the dashboard (12+ characters; 32+ and not dev-admin-token on 133/177).
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token

# Storage (SQLite, WAL). Tests never use this path.
DB_PATH=./data/clearing.db

# Settlement: 0 = manual only (POST /v1/settlements).
SETTLE_INTERVAL_SEC=0
SETTLE_MIN_CALLS=1
FUNDS_REFRESH_SEC=30

# HSP: local (built-in adapter + verifier) or coordinator (HashKey HSP Coordinator).
HSP_MODE=local
HSP_COSIGN_TIMEOUT_SEC=20
# Required when HSP_MODE=coordinator. The node reads the chain name and verifying contract from GET /chains.
# HSP_COORDINATOR_URL=
# HSP_API_KEY=
# Optional: fallback registry name, a pin the registry must match (refuses to start otherwise), required capabilities.
# HSP_CHAIN_NAME=
# HSP_VERIFYING_CONTRACT=
# HSP_REQUIRED_CAPABILITIES=

# Finality: a batch is confirmed and booked once its block is at or below this head.
# Default safe on HashKey Chain (133, 177), latest on anvil. finalized waits for Ethereum finality (~27 min on mainnet).
# CONFIRM_TAG=safe
# Same-nonce replacement with fees +12.5 % when a transaction is not included after this many blocks.
TX_BUMP_AFTER_BLOCKS=5
TX_MAX_BUMPS=5
# Retries for transient RPC errors (network, timeouts, 429, 5xx) with exponential backoff and jitter.
RPC_RETRIES=4
# Attest each confirmed batch on the EAS predeploy (HashKey Chain only).
EAS_ATTEST=false

# Rate limits (token buckets: requests per second and burst; 0 rps disables). Answers 429 with Retry-After.
# Per provider API key on POST /v1/vouchers:
RATE_LIMIT_PROVIDER_RPS=200
RATE_LIMIT_PROVIDER_BURST=1000
# Per client IP on every request without the admin token (public reads, cosign, signed revokes, failed auth):
RATE_LIMIT_IP_RPS=100
RATE_LIMIT_IP_BURST=1000
# Reverse proxies in front of the node whose X-Forwarded-For you trust (1 behind Caddy or nginx). 0 = socket address.
TRUST_PROXY_HOPS=0

# Growth bounds: identical denials within DENIAL_DEDUP_SEC fold into one row; oldest rows past the caps are pruned.
DENIAL_DEDUP_SEC=60
DENIALS_MAX_ROWS=100000
EVENTS_MAX_ROWS=200000

# Backups (pnpm --filter @payminto/node backup) are written here.
# BACKUP_DIR=./backups

LOG_LEVEL=info
