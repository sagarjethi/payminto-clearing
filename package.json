{
  "name": "payminto-clearing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "contracts:test": "cd contracts && forge test",
    "demo": "pnpm --filter @payminto/demo demo",
    "demo:stage": "pnpm --filter @payminto/demo demo:stage",
    "mcp": "pnpm --filter @payminto/mcp start"
  }
}
