# docker compose settings for a live Clearing Node. Copy to .env (git-ignored) next to docker-compose.yml.
# Without a .env, `docker compose --profile local up` runs the zero-money local stack instead.
# Every node variable is documented in apps/node/.env.example; anything set here reaches the node container.

# Chain: 133 (HashKey testnet) or 177 (HashKey mainnet)
CHAIN_ID=133
RPC_URL=https://testnet.hsk.xyz
# Comma-separated fallbacks; unset uses the network defaults, "none" disables.
# RPC_FALLBACK_URLS=

# Required on 133/177 unless contracts/deployments/<CHAIN_ID>.json in the image has them.
# HUB_ADDRESS=
# TOKEN_ADDRESS=
# DEPLOY_BLOCK=

# Operator key: a fresh key that only holds a little HSK for gas. Public dev keys are refused on 133/177.
OPERATOR_KEY=
# 32+ random characters: openssl rand -hex 32
ADMIN_TOKEN=

# Public URLs (behind your TLS reverse proxy, docs/OPERATIONS.md)
PUBLIC_URL=https://node.example.com
CORS_ORIGINS=https://dashboard.example.com
# Baked into the dashboard image at build time: the node URL as the operator's browser sees it.
NEXT_PUBLIC_NODE_URL=https://node.example.com
# One reverse proxy in front of the node: trust one X-Forwarded-For hop for per-IP rate limits.
TRUST_PROXY_HOPS=1

# Host bindings (loopback by default; the reverse proxy runs on the same host).
# NODE_PUBLISH=127.0.0.1:8787
# DASHBOARD_PUBLISH=127.0.0.1:3000

SETTLE_INTERVAL_SEC=300
SETTLE_MIN_CALLS=1
LOG_LEVEL=info
